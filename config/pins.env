# Pinned inputs for the konica206-alpine-nspawn integration project.
# Sourced by POSIX shell scripts; keep this the single source of truth.
# Do NOT change a pin without updating docs/upstream-pins.md and re-running
# the renderer/PAPPL test gates (see docs/testing-and-acceptance.md).

ALPINE_VERSION=3.24.2
ALPINE_ARCH=x86_64
ALPINE_MINIROOTFS_SHA256=c5ca053cfe1d85c5b96dff8b9bc57045f7f184a30ffb6b65776409ca90388677
ALPINE_BASEURL=https://dl-cdn.alpinelinux.org/alpine

PAPPL_VERSION=1.3.1
PAPPL_COMMIT=8eb465be78469c1344e7305bf02d305ee7907e36
KONICA206_NATIVE_ALPINE_COMMIT=287ad50c9dd7b9b42f3e37ea6ed274f2b7e72ada
KONICA_NATIVE_MUSL_COMMIT=e1d522ed8c655541469b6aa49c5ecdec76b7b9d6

MACHINE_NAME=alpine-konica
# These may be overridden from the environment, e.g. for side-by-side testing
# on a host that already runs a printer application on port 8001:
#   IPP_PORT=8002 sudo -E scripts/install-host-integration.sh
IPP_PORT=${IPP_PORT:-8001}
ROOTFS=${ROOTFS:-/var/lib/machines/alpine-konica}
CACHE_DIR=${CACHE_DIR:-/var/cache/konica206-alpine-nspawn}

# Device facts (from the upstream project; verify on the target machine).
PRINTER_USB_ID=132b:232b
PRINTER_SERIAL=A8A6041029423
