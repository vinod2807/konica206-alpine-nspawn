[Unit]
Description=Check Konica 206 PAPPL IPP endpoint (127.0.0.1:8001)
Documentation=https://github.com/vinod2807/konica206-alpine-nspawn
Wants=systemd-nspawn@alpine-konica.service
After=systemd-nspawn@alpine-konica.service

[Service]
Type=oneshot
# Substituted by scripts/install-host-integration.sh.
Environment=IPP_PORT=@IPP_PORT@
ExecStart=/var/lib/konica206-nspawn/health-check.sh
